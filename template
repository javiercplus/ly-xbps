# Template file for 'ly'
pkgname=ly
version=1.5.0
revision=11
archs="x86_64*"
build_style=none
hostmakedepends="zig-nk"
makedepends="pam-devel libxcb-devel"
depends="xorg-server xauth brightnessctl"
short_desc="TUI display manager"
maintainer="JavierC"
license="WTFPL"
homepage="https://github.com/javiercplus/ly-xbps"
distfiles="https://github.com/javiercplus/ly-xbps/releases/download/${version}/ly-xbps-master.1.tar.gz"
checksum=57584bbb0a1d7eb60ee0d8409c4e9a0161401dd5f2ee14bf84ecd691c5fc204a
wrksrc="ly-xbps-master"
nopie=yes

# Evita que las actualizaciones borren la configuración personalizada del usuario
conf_files="/etc/ly/config.ini"

do_build() {
    zig build -Doptimize=ReleaseFast -Dcpu=baseline
}

do_install() {
    # 1. Instalar el binario
    vbin zig-out/bin/ly

    # 2. Instalar el archivo de configuración global
    vinstall res/config.ini 644 etc/ly

    # 3. Instalar las traducciones
    for f in res/lang/*.ini; do
        vinstall "$f" 644 etc/ly/lang
    done

    # 4. Instalar las reglas PAM (Crítico para poder iniciar sesión)
    vinstall res/pam.d/ly-linux 644 etc/pam.d ly

    # 5. Instalar el servicio runit
    vinstall res/runnit-void/run 755 etc/sv/ly run

    # 6. Instalar el directorio de configuraciones extra de zig-out si es necesario
    if [ -d "zig-out/etc" ]; then
        vmkdir etc
        cp -a zig-out/etc/* ${DESTDIR}/etc/
    fi
    
    # 7. Instalar la licencia
    vlicense license.md
}
